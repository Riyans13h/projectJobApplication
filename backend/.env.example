SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

DB_URL=jdbc:sqlite:./jobflow.db?busy_timeout=10000
DB_USERNAME=
DB_PASSWORD=
DB_DRIVER=org.sqlite.JDBC
DB_POOL_MAX_SIZE=1
DB_POOL_MIN_IDLE=1
HIBERNATE_DIALECT=org.hibernate.community.dialect.SQLiteDialect

JWT_SECRET_KEY=change-this-to-a-long-secure-secret-for-local-development
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_PUBLIC_BASE_URL=http://localhost:8080/api
LOCAL_FILE_STORAGE_DIR=uploads

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=60

SEED_DATA_ENABLED=false
SEED_DEMO_EMAIL=demo@jobflow.local
SEED_DEMO_PASSWORD=DemoPassword123
SEED_DEMO_FIRST_NAME=Demo
SEED_DEMO_LAST_NAME=User
SEED_SAMPLE_FILE_BASE_URL=https://res.cloudinary.com/demo/raw/upload/jobflow/seed
